@startuml
title Nortadas - Scheduler Flow: fetch weather -> detect Nortada -> persist

'Formatting
skinparam monochrome false
skinparam defaultFontName Futura
skinparam backgroundColor #adb5bd
skinparam ArrowFontColor #141414
skinparam ArrowColor #141414
skinparam ArrowFontSize 13
skinparam ArrowThickness 2
skinparam sequence {
    ParticipantBackgroundColor #4c6ef5
    ParticipantFontColor #ffffff
    ParticipantBorderColor #364fc7
    ActorBackgroundColor #4c6ef5
    ActorFontColor #ffffff
    LifeLineBorderColor #364fc7
    LifeLineBackgroundColor #dbe4ff
}
skinparam note {
    BackgroundColor #4c6ef5
    FontColor #ffffff
    BorderColor #364fc7
}

' Runs hourly (US009). Detection runs year-round (US010).

participant "WeatherDataScheduler\n<<scheduler>>" as Scheduler
participant "FetchWeatherUseCase\n<<application>>" as UseCase
participant "BeachRepositoryPort\n<<port>>" as BeachRepo
participant "WeatherClientPort\n<<port>>" as WClient
participant "OpenMeteoClientAdapter\n<<infrastructure>>" as OpenMeteo
participant "NortadaDetectionService\n<<domain>>" as Detection
participant "WeatherReadingRepositoryPort\n<<port>>" as ReadingRepo

Scheduler -> UseCase : runHourly() -> fetchAllBeaches()
activate UseCase

UseCase -> BeachRepo : findAll()
activate BeachRepo
BeachRepo --> UseCase : List<Beach>
deactivate BeachRepo

loop for each Beach
    UseCase -> WClient : fetchCurrent(lat, lon)
    activate WClient
    WClient -> OpenMeteo : GET /v1/forecast?...
    activate OpenMeteo
    OpenMeteo --> WClient : WeatherReading (mapped from JSON)
    deactivate OpenMeteo
    WClient --> UseCase : WeatherReading
    deactivate WClient

    UseCase -> Detection : detect(reading)
    activate Detection
    note right of Detection
      Strategy: wind direction 315-45 deg
      gates; sustained speed grades
      NONE/LIGHT/MODERATE/STRONG/SEVERE (US010)
    end note
    Detection --> UseCase : NortadaStatus
    deactivate Detection

    UseCase -> ReadingRepo : save(reading)
    activate ReadingRepo
    ReadingRepo --> UseCase : persisted WeatherReading
    deactivate ReadingRepo

    alt fetch or persist fails
        note over UseCase : log error, continue to next beach\n(failed fetch must not crash app - US009)
    end
end

UseCase --> Scheduler : done
deactivate UseCase

@enduml
